DELETE p1
FROM Person p1
JOIN Person p2
  ON p1.email = p2.email AND p1.id > p2.id;

## Delete all duplicate emails and keep only the record with the smallest id
## self join: link 2 tables
## p1.email = p2.email AND p1.id > p2.id: this is the condition, which keeps all duplicate emails with larger ids will be deleted.
